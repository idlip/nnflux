use nix

# See README.org
export NNFLUX_TEST_DIR="$PWD/miniflux-test"
export NNFLUX_PGDATA="$NNFLUX_TEST_DIR/pgdata"
export NNFLUX_PGSOCK="$NNFLUX_TEST_DIR/pgsock"
export NNFLUX_PGPORT=15432
mkdir -p "$NNFLUX_PGSOCK"

# Miniflux itself reads these two directly.
export DATABASE_URL="postgres://miniflux@/miniflux?host=$NNFLUX_PGSOCK&port=$NNFLUX_PGPORT&sslmode=disable"
export LISTEN_ADDR=127.0.0.1:8080

# nnflux-tests.el reads these for the live tests.
export NNFLUX_TEST_URL="http://127.0.0.1:8080"
export NNFLUX_TEST_USER=admin
export NNFLUX_TEST_PASSWORD=test1234pass
